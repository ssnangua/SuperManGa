{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuperManGa",
  "version": "1.0.6",
  "identifier": "dev.ssnangua.supermanga",
  "build": {
    "beforeDevCommand": "npx vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/fetch-pdfium.mjs && npx vue-tsc --noEmit && npx vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SuperManGa",
        "label": "main",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": true,
        "shadow": true,
        "dragDropEnabled": true,
        "backgroundColor": "#000000",
        "theme": "Dark",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://comic.localhost comic: http://neural.localhost neural: blob:; img-src 'self' http://comic.localhost comic: http://neural.localhost neural: blob: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/pdfium/"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/supermanga.desktop"
      }
    }
  }
}
