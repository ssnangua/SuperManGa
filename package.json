{
  "name": "supermanga",
  "private": true,
  "version": "1.0.4",
  "description": "A simple, practical local manga reader with upscaling and translation.",
  "type": "module",
  "homepage": "https://github.com/ssnangua/SuperManGa",
  "scripts": {
    "dev": "tauri dev",
    "fetch:pdfium": "node scripts/fetch-pdfium.mjs",
    "predev": "node scripts/fetch-pdfium.mjs --optional",
    "build": "tauri build --no-bundle",
    "build:win": "tauri build --no-bundle && node scripts/pack-portable.mjs",
    "build:mac": "tauri build --bundles dmg",
    "build:linux": "tauri build --bundles deb",
    "bundle:win-full": "node scripts/bundle-win-full.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "version": "node scripts/sync-version.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "anime4k.js": "^1.1.5",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.22"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
